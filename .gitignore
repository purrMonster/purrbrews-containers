# This repo is public. Anything a node generates or renders stays on that node.
# One .gitignore for the whole repo; the nodes used to have one each and they
# drifted apart.

# --- Settings and secrets ---------------------------------------------------
# Real values only ever exist on the node that made them. What's committed is
# the *.example / *.template / secrets.conf that describes them.
.env.local
*.env.local
secrets.env*
!*.example
*.key
*.pem
*.p12
*.pfx
id_rsa*
id_ed25519*
ssh_authorized_keys.txt
remote_url.txt
init/purrbrews-init.env
init/authorized_keys
bootstrap/.env
bootstrap/data/

# Written by init/purrbrews-init.sh on each node.
/.env

# Backup keys: which node may write where. Public keys, but per-host state,
# and the pinning (from=) is the part that matters.
stacks/cellar/restic/dump-store.keys
stacks/roastery/backup-target/authorized_keys
# cellar's old rendered rclone config; rclone's own now lives in /etc/purrbrews.
stacks/cellar/restic/rclone.conf

# Komodo Core's public key, copied by hand from cellar to every node. Not
# secret, but it's per-host state, not config.
stacks/*/komodo-periphery/keys/

# --- Rendered from *.template by render-configs ------------------------------
# One line per template. tests/test_infrastructure.py fails if a template's
# output isn't listed here, so a new template can't leak its secrets.
stacks/cellar/traefik/config/dynamic.yml
stacks/cellar/traefik/config/traefik.yml
stacks/grinder/traefik/config/dynamic.yml
stacks/grinder/traefik/config/traefik.yml
stacks/mochaPot/kiosk/bash_profile
stacks/mochaPot/traefik/config/dynamic.yml
stacks/mochaPot/traefik/config/traefik.yml
stacks/percolator/authelia/config/configuration.yml
stacks/percolator/traefik/config/dynamic.yml
stacks/percolator/traefik/config/traefik.yml
stacks/percolator/vikunja/config/config.yml
stacks/roastery/traefik/config/dynamic/ollama.yml
stacks/roastery/traefik/config/traefik.yml

# --- Runtime data -----------------------------------------------------------
# App data lives under DATA_DIR (/srv/data) on the node, never in the repo.
data/
volumes/
*.sqlite
*.sqlite3
*.db
*.log
backups/
*.tar
*.tar.gz
stacks/cellar/restic/cache/
stacks/mochaPot/kiosk/profile/
stacks/roastery/immich-ml/model-cache/
stacks/roastery/traefik/traefik.exe

# --- Claude collaboration workspace -----------------------------------------
claude/

# --- Editors, OS, Python ----------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
__pycache__/
*.pyc
