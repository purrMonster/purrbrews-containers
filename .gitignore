# This repo is public. Anything a node generates or renders stays on that node.
# One .gitignore for the whole repo; the nodes used to have one each and they
# drifted apart. Paths follow the 2026-11 layout: stacks/<group>/<app>, nodes/<node>.

# --- Settings and secrets ---------------------------------------------------
# Real values only ever exist on the node that made them. What's committed is
# the *.example / *.template / secrets.conf that describes them.
.env.local
*.env.local
secrets.env*
!*.example
*.key
*.pem
*.p12
*.pfx
id_rsa*
id_ed25519*
ssh_authorized_keys.txt
remote_url.txt
deprecated/init/purrbrews-init.env
deprecated/init/authorized_keys
deprecated/bootstrap/.env
deprecated/bootstrap/data/

# Written on each node when it is set up (NODE, NODE_IP, PUID/PGID, DATA_DIR).
/.env
# scripts/fleet.py's per-node deployment records (no command output in them).
/.fleet/

# Backup keys: which node may write where. Public keys, but per-host state,
# and the pinning (from=) is the part that matters.
stacks/backup/restic/backup.keys
deprecated/stacks/roastery/backup-target/authorized_keys
# The hub's old rendered rclone config; rclone's own now lives in /etc/purrbrews.
stacks/backup/restic/rclone.conf

# Komodo Core's public key, copied by hand from cellar to every node. Not
# secret, but it's per-host state, not config.
stacks/*/komodo-periphery/keys/

# --- Rendered from *.template by render-configs ------------------------------
# One line per template. tests/test_infrastructure.py fails if a template's
# output isn't listed here, so a new template can't leak its secrets.
stacks/ai/litellm/config/config.yaml
stacks/apps/opencloud/config/csp.yaml
stacks/apps/opencloud/config/proxy.yaml
stacks/apps/radicale/config/config
stacks/apps/radicale/config/ldap-password
stacks/apps/vikunja/config/config.yml
stacks/automation/pourover/config/users.yaml
stacks/home/kiosk/bash_profile
stacks/identity/authelia/config/configuration.yml
stacks/network/cloudflared/config/config.yml
stacks/network/traefik-ingress/config/dynamic.yml
stacks/network/traefik-ingress/config/traefik.yml
stacks/network/traefik/config/dynamic.yml
stacks/network/traefik/config/traefik.yml
# --- Runtime data -----------------------------------------------------------
# App data lives under DATA_DIR (/srv/data) on the node, never in the repo.
data/
volumes/
*.sqlite
*.sqlite3
*.db
*.log
backups/
*.tar
*.tar.gz
stacks/backup/restic/cache/
stacks/home/kiosk/profile/
deprecated/stacks/roastery/traefik/traefik.exe
deprecated/stacks/roastery/game-mode/state.json

# --- Claude collaboration workspace -----------------------------------------
claude/

# --- Editors, OS, Python ----------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
__pycache__/
*.pyc

Claude outputs/

stacks/apps/radicale/config/config
stacks/apps/radicale/config/ldap-password
stacks/apps/opencloud/config/proxy.yaml
stacks/apps/opencloud/config/csp.yaml
