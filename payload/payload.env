# payload.env — settings for the fleet's bootstrap payload (purrbrews-node.sh).
#
# Served openly by purrbrews-bootstrap with the rest of payload/, so nothing in
# this file is secret: no tokens, no ping URLs, not the real domain.
# Node addresses, the gateway, the LAN and the timezone are not here: they
# come from stacks/fleet.env in the checkout the payload makes.
#
# Format: KEY=value, one per line. Read, never executed.

# ── Repository ──────────────────────────────────────────────────────────────
# Cloned anonymously over https. Never put a credential in this URL.
REPO_URL=https://github.com/purrMonster/purrbrews-containers.git
REPO_BRANCH=main

# ── Folders on the node ─────────────────────────────────────────────────────
PROJECT_DIR=/opt/purrbrews
DATA_DIR=/srv/data
MEDIA_DIR=/srv/media

# ── Network ─────────────────────────────────────────────────────────────────
# Each node's wired interface gets a fixed MAC derived from its name, so the
# router and Pi-hole see the same device after a reinstall or a new USB
# Ethernet adapter. See them with: bash scripts/fleet-macs.sh
CLONE_MAC=true
# Optional overrides, space-separated name=mac.
NODE_MACS=
# Resolvers a node uses until the Pi-holes are up (Pi-hole's DHCP hands out
# its own once it runs). Space-separated.
BOOTSTRAP_DNS=1.1.1.1 9.9.9.9

# ── Daily fetch ─────────────────────────────────────────────────────────────
# systemd OnCalendar syntax. The fetch never moves the checkout: a reviewed
# commit is deployed by hand (docs/operations.md).
PULL_SCHEDULE=*-*-* 06:15:00

# ── Tailnet (the tailnet step: --only tailnet; tailscale/README.md) ─────────
# The tag every node joins with; tailscale/policy.hujson grants on it.
TAILSCALE_TAGS=tag:purrbrews-node
# The nodes that carry web (443) and DNS (53) from the tailnet onto the LAN.
# Two, so either can be down; both are always on.
TAILSCALE_SUBNET_ROUTERS=cellar grinder
# A /23 around the house's /24 (192.168.1.0/24): at home a device's own /24
# is the more specific route and wins, so only away from home does traffic
# go through the tailnet.
TAILSCALE_ROUTES=192.168.0.0/23
