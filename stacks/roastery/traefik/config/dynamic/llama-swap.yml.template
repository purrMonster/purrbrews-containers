# Rendered by ../../render-configs.ps1 into config/dynamic/llama-swap.yml (gitignored).
# llama-swap (../../../llama-swap) has no auth, so it publishes on localhost
# only and this is the only way in: LAN clients, then an Authelia login
# (admins, or the ollama_api_group service accounts; see percolator's Authelia
# template).
#
# The hostname is still ollama.${DOMAIN}: Authelia's rules, the Pi-hole
# records, the tunnel config and the tests all know it by that name, and
# renaming it is a fleet-wide change of its own (runbook, 2026-10-07). It now
# speaks the OpenAI API (/v1/...), not Ollama's (/api/tags is gone).
http:
  middlewares:
    llm-lan:
      ipAllowList:
        sourceRange:
          - '${LAN_CIDR}'
          - '127.0.0.1/32'
          - '::1/128'
    authelia:
      forwardAuth:
        # forward-auth-basic, not forward-auth: the service accounts send Basic
        # auth, which only that endpoint accepts.
        address: 'http://${PERCOLATOR_LAN_IP}:9091/api/authz/forward-auth-basic'
        trustForwardHeader: true
        maxResponseBodySize: 8192
        authResponseHeaders:
          - Remote-User
          - Remote-Groups
          - Remote-Email
          - Remote-Name
  routers:
    llm:
      rule: 'Host(`ollama.${DOMAIN}`)'
      entryPoints: [websecure]
      middlewares: [llm-lan, authelia]
      service: llama-swap
      tls:
        certResolver: cloudflare
  services:
    llama-swap:
      loadBalancer:
        servers:
          # Docker Desktop's published 127.0.0.1:9292 (llama-swap/docker-compose.yml).
          - url: 'http://127.0.0.1:9292'
