# Rendered by ../../render-configs.ps1 into config/dynamic/ollama.yml (gitignored).
# Ollama has no auth, so it listens on localhost only and this is the only way
# in: LAN clients, then an Authelia login (admins, or the ollama_api_group
# service accounts; see percolator's Authelia template).
http:
  middlewares:
    ollama-lan:
      ipAllowList:
        sourceRange:
          - '${LAN_CIDR}'
          - '127.0.0.1/32'
          - '::1/128'
    authelia:
      forwardAuth:
        # forward-auth-basic, not forward-auth: the service accounts send Basic
        # auth, which only that endpoint accepts.
        address: 'http://${PERCOLATOR_LAN_IP}:9091/api/authz/forward-auth-basic'
        trustForwardHeader: true
        maxResponseBodySize: 8192
        authResponseHeaders:
          - Remote-User
          - Remote-Groups
          - Remote-Email
          - Remote-Name
  routers:
    ollama:
      rule: 'Host(`ollama.${DOMAIN}`)'
      entryPoints: [websecure]
      middlewares: [ollama-lan, authelia]
      service: ollama
      tls:
        certResolver: cloudflare
  services:
    ollama:
      loadBalancer:
        servers:
          - url: 'http://127.0.0.1:11434'
