# roastery — node settings. setup-secrets.sh copies this to .env.local
# (gitignored) and asks for anything still REPLACE_ME.
#
# Unlike the Debian fleet nodes, roastery has no /opt/purrbrews/.env from
# init/purrbrews-init.sh (it isn't provisioned by that script) and no
# $DATA_DIR convention -- this is the first app built here, and inventing
# fleet-wide policy off one app's needs isn't worth it yet. compose.sh loads
# this file, then the app's own secrets.env.local if it has one.

TZ=Asia/Kolkata

# ── immich-ml ─────────────────────────────────────────────────────────────
# No settings needed yet -- immich-ml has no secrets and no config template.
# One reminder, not a variable (nothing in this repo reads env vars for image
# tags): before bumping immich-ml/docker-compose.yml's image tag, check
# stacks/percolator/immich/docker-compose.yml's immich-server tag first.
# The two must always match -- Immich's own compatibility rule.
