# roastery's own settings. setup-secrets.ps1 (or .sh) copies this to
# .env.local (gitignored) and asks for anything still REPLACE_ME.
#
# Loaded after stacks/fleet.env, which already has TZ, LAN_CIDR and the fleet
# nodes' IPs (PERCOLATOR_LAN_IP for Authelia, CELLAR_LAN_IP for Komodo).
# There's no /opt/purrbrews/.env on Windows.

# ── Traefik (native, in front of llama-swap) ────────────────────────────────
DOMAIN=REPLACE_ME.example.com
TRAEFIK_ACME_EMAIL=REPLACE_ME@example.com

# ── Komodo Periphery ────────────────────────────────────────────────────────
# Only for the first connect: an onboarding key from Komodo's UI on cellar
# (Settings → onboarding, named "roastery"). Leave it empty once roastery
# shows up as a Server. It lives here rather than in a secrets file because
# roastery has no secrets step yet.
PERIPHERY_ONBOARDING_KEY=

# ── persianPerch's kitten (the Scheduled Task from persianPerch's integration/roastery) ─
# The token cellar made for roastery (PERCH_KITTEN_TOKEN_ROASTERY in cellar's
# persian-perch/secrets.env.local). setup-secrets.ps1 asks for it; nothing else holds it.
KITTEN_TOKEN=REPLACE_ME

# ── Game mode (game-mode/game-mode.ps1, a scheduled task at logon) ──────────
# Moves llama-swap to its CPU-only profile while a game runs (game-mode/README.md).
# Where llama-swap answers on this PC: llama-swap/docker-compose.yml publishes here.
LLAMA_SWAP_URL=http://127.0.0.1:9292
# A running program whose path contains one of these is a game. Semicolon-
# separated, any case, / or \ alike. Single quotes: these are read by bash too.
GAME_PATHS='/steamapps/common/;/Epic Games/;/XboxGames/;/GOG Games/;/Riot Games/'
# ...unless its path also contains one of these: launchers, runtimes, tools.
GAME_IGNORE='/Epic Games/Launcher/;/steamapps/common/Steamworks Shared/;/steamapps/common/SteamVR/;/steamapps/common/Steam Controller Configs/'
# Games installed anywhere else, by executable name ('game.exe;other.exe').
GAME_EXES=''
# Optional: POSTed {"gaming": true|false, "game": ..., "since": ...} on every
# change, e.g. a Home Assistant webhook URL. Empty: off. Webhook URLs are
# secrets: keep it in .env.local, which is gitignored.
GAME_MODE_WEBHOOK_URL=''
