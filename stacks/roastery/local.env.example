# roastery's own settings. setup-secrets.ps1 (or .sh) copies this to
# .env.local (gitignored) and asks for anything still REPLACE_ME.
#
# Loaded after stacks/fleet.env, which already has TZ, LAN_CIDR and the fleet
# nodes' IPs (PERCOLATOR_LAN_IP for Authelia, CELLAR_LAN_IP for Komodo).
# There's no /opt/purrbrews/.env on Windows.

# ── Traefik (native, in front of Ollama) ────────────────────────────────────
DOMAIN=REPLACE_ME.example.com
TRAEFIK_ACME_EMAIL=REPLACE_ME@example.com

# ── Komodo Periphery ────────────────────────────────────────────────────────
# Only for the first connect: an onboarding key from Komodo's UI on cellar
# (Settings → onboarding, named "roastery"). Leave it empty once roastery
# shows up as a Server. It lives here rather than in a secrets file because
# roastery has no secrets step yet.
PERIPHERY_ONBOARDING_KEY=
