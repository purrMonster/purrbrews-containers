# fleet.env: facts about the house network that every node shares.
#
# Loaded first by compose.sh and render-configs.sh on every node, before
# /opt/purrbrews/.env and the node's own .env.local (either can override).
# Nothing secret goes here, and not the domain either; the addresses are the
# same ones the README already publishes.
#
# The node addresses must match NODE_IPS in init/purrbrews-init.env.example
# (tests/test_infrastructure.py checks that). Change both together.

TZ=Asia/Kolkata
LAN_CIDR=192.168.0.0/24
GATEWAY=192.168.0.1

SIEVE_LAN_IP=192.168.0.10
PERCOLATOR_LAN_IP=192.168.0.11
CELLAR_LAN_IP=192.168.0.12
MOCHAPOT_LAN_IP=192.168.0.13
GRINDER_LAN_IP=192.168.0.14

# The two Pi-holes, in the order DHCP hands them to clients.
DNS_PRIMARY=192.168.0.10
DNS_SECONDARY=192.168.0.13

# roastery isn't a fleet node, but the backups live on it (runbook, 2026-09-27),
# so every node needs its address. It has no DHCP reservation yet (backlog);
# until it does, check this after the router restarts.
ROASTERY_LAN_IP=192.168.0.15

# ── Backups (stacks/README.md → Backups) ────────────────────────────────────
# The restic repository: SFTP into roastery's OpenSSH, chrooted to
# C:\purrbrews, so /restic is C:\purrbrews\restic (roastery/backup-target).
BACKUP_REPOSITORY=sftp:restic@192.168.0.15:/restic
# Where each node writes its database dumps, and the node that collects
# everyone's (cellar: DUMP_DIR/<node>/ there is the dump store).
DUMP_DIR=/srv/dumps
DUMP_STORE_HOST=192.168.0.12
