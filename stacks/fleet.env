# fleet.env: facts about the house network that every node shares.
#
# Loaded first by compose.sh and render-configs.sh on every node, before
# /opt/purrbrews/.env and the node's own .env.local (either can override).
# Nothing secret goes here, and not the domain either.
#
# Rebuilt 2026-11 for the new house: the LAN is 192.168.1.0/24 behind the
# Humax router (its DHCP goes off once sieve's Pi-hole hands out leases), and
# roastery is out of the fleet (runbook.md, 2026-11-16). GATEWAY is the
# router's usual address; confirm it on the router before the first node goes
# up (docs/migration-plan.md, phase 1).

TZ=Asia/Kolkata
LAN_CIDR=192.168.1.0/24
GATEWAY=192.168.1.1

SIEVE_LAN_IP=192.168.1.10
PERCOLATOR_LAN_IP=192.168.1.11
CELLAR_LAN_IP=192.168.1.12
MOCHAPOT_LAN_IP=192.168.1.13
GRINDER_LAN_IP=192.168.1.14

# The two Pi-holes, in the order DHCP hands them to clients.
DNS_PRIMARY=192.168.1.10
DNS_SECONDARY=192.168.1.13

# ── Backups (stacks/README.md → Backups) ────────────────────────────────────
# The restic repository. It used to live on roastery; with roastery gone it
# is on cellar's 1 TB NVMe, reached over SFTP by every node, cellar included.
# The account is SFTP-only and chrooted to BACKUP_REPO_ROOT, so the path the
# nodes see (/restic) is BACKUP_REPO_ROOT/restic on cellar's disk.
# stacks/backup/restic/repo-setup.sh builds both from these two lines.
BACKUP_REPOSITORY=sftp:restic@192.168.1.12:/restic
BACKUP_REPO_ROOT=/srv/backup
# Where each node writes its database dumps, and the node that collects
# everyone's (cellar: DUMP_DIR/<node>/ there is the dump store).
DUMP_DIR=/srv/dumps
DUMP_STORE_HOST=192.168.1.12
