[Unit]
Description=purrbrews nightly backup (%i), 01:30

[Timer]
# Every node backs up to cellar (the repository and the dump store); one
# that finds cellar rebooting waits up to ten minutes for it. The random
# delay keeps five nodes from opening their SFTP sessions in the same second.
OnCalendar=*-*-* 01:30:00
RandomizedDelaySec=5min
# Missed because the node was off: run at the next boot rather than skip a day.
Persistent=true

[Install]
WantedBy=timers.target
