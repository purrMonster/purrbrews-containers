# shellcheck shell=bash
# Sourced by stacks/_lib/secrets.sh after secrets.conf. The hub makes the
# repository password and holds the Drive copy's keys; every other node is
# asked for the hub's password. Which one this node is comes from node.conf.
if [[ "$BACKUP_HUB" == true ]]; then
  apply_spec_file restic "$(app_dir restic)/secrets.hub.conf"
else
  apply_spec_file restic "$(app_dir restic)/secrets.client.conf"
fi
