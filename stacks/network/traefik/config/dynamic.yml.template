# Rendered by the node's ./render-configs.sh into config/dynamic.yml (gitignored).
#
# The ForwardAuth middlewares the app labels use as authelia-forwardauth@file
# and authelia-forwardauth-basic@file. Straight to Authelia on percolator:9091:
# a second Traefik in the path drops X-Forwarded-Method and Authelia answers
# 400. The node's address has to be in percolator's FORWARD_AUTH_CLIENTS, and
# an admin-only host in Authelia's admin host list.
http:
  middlewares:
    # People, by session cookie.
    authelia-forwardauth:
      forwardAuth:
        address: "http://${PERCOLATOR_LAN_IP}:9091/api/authz/forward-auth"
        trustForwardHeader: true
        authResponseHeaders:
          - Remote-User
          - Remote-Groups
          - Remote-Name
          - Remote-Email
    # API clients with no browser session: an LLDAP service account sends
    # Basic auth, which only forward-auth-basic accepts (the llm route).
    authelia-forwardauth-basic:
      forwardAuth:
        address: "http://${PERCOLATOR_LAN_IP}:9091/api/authz/forward-auth-basic"
        trustForwardHeader: true
        authResponseHeaders:
          - Remote-User
          - Remote-Groups
          - Remote-Name
          - Remote-Email
