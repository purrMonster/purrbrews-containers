# Rendered by the node's ./render-configs.sh into config/traefik.yml (gitignored).
log:
  level: INFO

# For the container's healthcheck: /ping on Traefik's internal entry point
# (:8080), which nothing publishes. The dashboard stays off it.
ping: {}

entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
  websecure:
    address: ":443"
    # sieve's cloudflared: trust its X-Forwarded-For so logs and apps
    # see tunnel visitors' real addresses instead of sieve's.
    forwardedHeaders:
      trustedIPs:
        - "${SIEVE_LAN_IP}/32"
    transport:
      respondingTimeouts:
        # v3 defaults readTimeout to 60s, which cuts off large uploads
        # mid-transfer (Immich on grinder; same as traefik-ingress).
        readTimeout: 0s

certificatesResolvers:
  cloudflare:
    acme:
      email: ${TRAEFIK_ACME_EMAIL}
      storage: /acme/acme.json
      dnsChallenge:
        provider: cloudflare
        resolvers:
          - "1.1.1.1:53"
          - "1.0.0.1:53"

providers:
  docker:
    endpoint: "unix:///var/run/docker.sock"
    exposedByDefault: false
    # The node's bridge network. Host-networked apps never join it; their
    # labels carry a server URL, so no address is looked up for them.
    network: proxy
  file:
    filename: /etc/traefik/dynamic.yml
