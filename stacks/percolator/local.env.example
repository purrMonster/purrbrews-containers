# percolator — node settings. Nothing here is secret.
#
# ./setup-secrets.sh copies this to .env.local (gitignored) and asks for every
# REPLACE_ME value. Keys added here later are appended to an existing
# .env.local on the next run. Loaded by compose.sh and render-configs.sh,
# after /opt/purrbrews/.env (NODE_IP, TZ, PUID/PGID, DATA_DIR, MEDIA_DIR).
#
# Format: KEY=value, no spaces around '='. This file is sourced by bash, so
# quote values that contain spaces.

# ── Domain ───────────────────────────────────────────────────────────────────
# Every app is served as <app>.${DOMAIN} with one wildcard certificate.
DOMAIN=REPLACE_ME.example.com
# Email for the Let's Encrypt account (expiry notices).
ACME_EMAIL=REPLACE_ME@example.com

# ── Network ──────────────────────────────────────────────────────────────────
LAN_CIDR=192.168.0.0/24
# sieve runs cloudflared. Traefik trusts X-Forwarded-For only from here, so
# tunnel visitors are logged (and banned by CrowdSec) by their real address.
SIEVE_IP=192.168.0.10
# Nodes whose Traefik calls Authelia's published port 9091 for ForwardAuth
# (space-separated IPs). firewall.sh opens 9091 to these and nobody else.
# Add a node here when its Traefik lands, then re-run sudo ./firewall.sh.
FORWARD_AUTH_CLIENTS=192.168.0.10
# Shared Docker network for Traefik and every app's web container. Fixed so
# apps can list it as their trusted proxy. Change only before first bring-up.
PROXY_SUBNET=172.30.0.0/24

# ── Identity ────────────────────────────────────────────────────────────────
# LLDAP base DN. Internal naming only, unrelated to DOMAIN.
LDAP_BASE_DN=dc=purrbrews,dc=internal
# LLDAP groups. Admins reach the Traefik dashboard; lldap-bootstrap.sh
# creates both groups and puts the ops user in both.
LLDAP_ADMIN_GROUP=purrbrews_admins
LLDAP_HOUSEHOLD_GROUP=purrbrews_household
# Authelia policy for everything (ForwardAuth and OIDC). Switch to two_factor
# only after every household account has enrolled a second factor.
AUTH_POLICY=one_factor

# ── Immich ──────────────────────────────────────────────────────────────────
# Machine learning runs on roastery's GPU (immich-machine-learning there).
# Immich works without it; face recognition and smart search wait until the
# URL answers.
IMMICH_ML_URL=http://REPLACE_ME_ROASTERY_IP:3003

# ── Vaultwarden ─────────────────────────────────────────────────────────────
# Leave true until every household vault exists, then set false and
# ./compose.sh vaultwarden up -d. SSO logins still need an account or invite.
VAULTWARDEN_SIGNUPS_ALLOWED=true

# ── Paperless ───────────────────────────────────────────────────────────────
# Tesseract language codes, '+'-separated (e.g. eng+hin). Only languages
# bundled in the image work without extra setup.
PAPERLESS_OCR_LANGUAGE=eng
