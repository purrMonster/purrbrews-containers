# percolator's own settings. ./setup-secrets.sh copies this to .env.local
# (gitignored) and asks for every REPLACE_ME. Nothing here is secret.
#
# Loaded after stacks/fleet.env (LAN, gateway, node IPs) and
# /opt/purrbrews/.env (NODE, NODE_IP, PUID/PGID, DATA_DIR).
#
# KEY=value, no spaces around '='. The renderer sources this with bash, so
# quote a value that has spaces in it.

# ── Domain ───────────────────────────────────────────────────────────────────
# Every app is <app>.${DOMAIN}, all on one wildcard certificate.
DOMAIN=REPLACE_ME.example.com
# Let's Encrypt account email, for expiry warnings.
TRAEFIK_ACME_EMAIL=REPLACE_ME@example.com

# ── Network ──────────────────────────────────────────────────────────────────
# Whose Traefik may call Authelia's published port 9091 for ForwardAuth,
# space-separated. firewall.sh opens 9091 to these and nobody else, so a node
# (or roastery) that starts protecting routes goes here, then sudo ./firewall.sh.
FORWARD_AUTH_CLIENTS='192.168.0.10 192.168.0.12 192.168.0.13 192.168.0.14'
# The `proxy` network Traefik and the web containers share. Fixed, because the
# apps list it as their trusted proxy. Only change it before the first bring-up.
PROXY_SUBNET=172.30.0.0/24

# ── Identity ────────────────────────────────────────────────────────────────
# LLDAP's base DN. Internal naming only, nothing to do with DOMAIN.
LDAP_BASE_DN=dc=purrbrews,dc=internal
# lldap-bootstrap.sh creates both groups and puts the ops user in both.
# Admins get the Traefik dashboards and the other admin-only pages.
LLDAP_ADMIN_GROUP=purrbrews_admins
LLDAP_HOUSEHOLD_GROUP=purrbrews_household
# Authelia's policy for people, on ForwardAuth and OIDC alike. two_factor only
# once every household account has a second factor enrolled, or they're locked out.
AUTH_POLICY=one_factor

# ── Immich ──────────────────────────────────────────────────────────────────
# Machine learning runs on roastery's GPU. Immich works without it; faces and
# smart search just wait until this answers.
IMMICH_ML_URL=http://REPLACE_ME_ROASTERY_IP:3003

# ── Vaultwarden ─────────────────────────────────────────────────────────────
# true until every household vault exists, then false and
# ./compose.sh vaultwarden up -d. SSO sign-ins still need an account or invite.
VAULTWARDEN_SIGNUPS_ALLOWED=true

# ── Paperless ───────────────────────────────────────────────────────────────
# Tesseract languages, '+'-separated (eng+hin). Only the ones in the image work
# without extra setup.
PAPERLESS_OCR_LANGUAGE=eng

# ── Scrutiny collector ──────────────────────────────────────────────────────
# Two disks: the 1 TB NVMe (/srv/data) and the 256 GB SATA SSD (the OS).
# Check with `lsblk -d -o NAME,SIZE,MODEL`; NVMe is the controller, /dev/nvme0.
DISK_DEVICE=REPLACE_ME
DISK_DEVICE_2=REPLACE_ME
