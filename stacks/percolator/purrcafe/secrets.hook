# shellcheck shell=bash
# Sourced by _lib/secrets.sh after secrets.conf. purrCafe sends GATUS_AUTHORIZATION
# as-is, so the Basic header is built here from the account and its password,
# on every run. Edit those two, never this one. Blank either = fleet panel off.

cafe_user="$(env_get "$FILE" CAFE_GATUS_USER)"
cafe_pass="$(env_get "$FILE" CAFE_GATUS_PASSWORD)"
if [[ -n "$cafe_user" && -n "$cafe_pass" ]] && ! is_placeholder "$cafe_user" && ! is_placeholder "$cafe_pass"; then
  env_put "$FILE" CAFE_GATUS_AUTHORIZATION "Basic $(printf '%s:%s' "$cafe_user" "$cafe_pass" | base64 -w0)"
else
  env_put "$FILE" CAFE_GATUS_AUTHORIZATION ''
fi
unset cafe_user cafe_pass
