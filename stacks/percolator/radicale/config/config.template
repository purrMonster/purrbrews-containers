# render-mode: 0644
# No secret in this file: the reader password has its own mode-0600 render.
[server]
hosts = 0.0.0.0:5232

[auth]
type = ldap
ldap_uri = ldap://lldap:3890
ldap_base = ou=people,${LDAP_BASE_DN}
ldap_reader_dn = uid=radicale-reader,ou=people,${LDAP_BASE_DN}
ldap_secret_file = /run/secrets/ldap-password
ldap_filter = (&(uid={0})(memberOf=cn=${LLDAP_HOUSEHOLD_GROUP},ou=groups,${LDAP_BASE_DN}))
ldap_user_attribute = uid
# Upstream default: retain the delay on failed authentication.
delay = 1

[rights]
type = owner_only

[storage]
filesystem_folder = /data/collections
