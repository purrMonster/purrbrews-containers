# sieve — node settings. setup-secrets.sh copies this to .env.local (gitignored)
# and asks for anything still REPLACE_ME. Nothing in here is a secret, but the
# real domain stays out of git.
#
# Node-wide values (NODE, NODE_IP, TZ, PUID/PGID, DATA_DIR) come from
# /opt/purrbrews/.env, written by init/purrbrews-init.sh. compose.sh loads that
# file first, then this one, then the app's secrets.env.local.

# ── Domain ──────────────────────────────────────────────────────────────────
# The zone on Cloudflare. Used for host names, certificates and ntfy's public URL.
DOMAIN=REPLACE_ME.example.com

# ACME account email for Traefik's Cloudflare DNS-01 cert issuance -- not a
# secret, just needs to be a real address (Let's Encrypt uses it for
# expiry-adjacent notices). Was missing here; every other node's Traefik
# already sets it under this same key (cellar/grinder/mochaPot) except
# percolator, which calls it ACME_EMAIL instead -- a naming drift worth
# reconciling at some point, not fixed here since it touches percolator's
# own template.
TRAEFIK_ACME_EMAIL=REPLACE_ME@REPLACE_ME.example.com

# ── Single sign-on ──────────────────────────────────────────────────────────
# Authelia on percolator, on its own published port. sieve's Traefik asks it
# whether each request to a protected UI is logged in (ForwardAuth).
AUTHELIA_URL=http://192.168.0.11:9091

# ── LAN ─────────────────────────────────────────────────────────────────────
LAN_CIDR=192.168.0.0/24
GATEWAY=192.168.0.1
# Wired interface NetAlertX scans. Leave empty: setup-secrets.sh fills it in
# from the default route.
LAN_INTERFACE=

# ── Docker networks (fixed, so firewall rules are stable) ───────────────────
# sieve_edge: traefik, cloudflared, ntfy, gatus. sieve_dns: unbound only.
EDGE_SUBNET=172.31.10.0/24
DNS_SUBNET=172.31.53.0/28
UNBOUND_IP=172.31.53.2

# ── DHCP (Pi-hole) ──────────────────────────────────────────────────────────
# Keep false until the router's DHCP server is switched off — never run two
# DHCP servers on one LAN. See pihole/README.md, "Handing over DHCP".
PIHOLE_DHCP_ACTIVE=false
PIHOLE_DHCP_START=192.168.0.50
PIHOLE_DHCP_END=192.168.0.250
# Clients renew at half the lease, so 7d gives ~3.5 days of grace if sieve is down.
PIHOLE_DHCP_LEASE=7d

# Extra static leases and DNS names, beyond the fleet nodes. Semicolon-separated.
#   leases: MAC,IP,name        e.g. aa:bb:cc:dd:ee:ff,192.168.0.20,roastery
#   names:  IP name            e.g. 192.168.0.20 roastery
PIHOLE_DHCP_EXTRA_HOSTS=
PIHOLE_DNS_EXTRA_HOSTS=

# Generated by setup-secrets.sh — fleet list (init/purrbrews-mac.sh), the extras
# above, and every node's Traefik routers. Don't edit; rewritten on every run.
PIHOLE_DHCP_HOSTS=
PIHOLE_DNS_HOSTS=
PIHOLE_DNSMASQ_LINES=
