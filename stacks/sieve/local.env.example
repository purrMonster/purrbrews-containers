# sieve's own settings. ./setup-secrets.sh copies this to .env.local
# (gitignored) and asks for anything still REPLACE_ME. Nothing here is secret,
# but the real domain stays out of git.
#
# Loaded after stacks/fleet.env (LAN, gateway, node IPs) and
# /opt/purrbrews/.env (NODE, NODE_IP, PUID/PGID, DATA_DIR), so none of those
# need repeating here.

# ── Domain ──────────────────────────────────────────────────────────────────
# The Cloudflare zone: host names, certificates and ntfy's public URL.
DOMAIN=REPLACE_ME.example.com
# Let's Encrypt account email. Only used for expiry warnings, but I want those.
TRAEFIK_ACME_EMAIL=REPLACE_ME@example.com

# ── LAN ─────────────────────────────────────────────────────────────────────
# The wired interface NetAlertX scans. Leave it empty and setup fills it in
# from the default route.
LAN_INTERFACE=

# ── Docker networks (fixed, so firewall rules stay valid across rebuilds) ───
# sieve_edge: traefik, cloudflared, ntfy, gatus. sieve_dns: unbound only.
# Changing DNS_SUBNET means changing unbound/config/access-control.conf too.
EDGE_SUBNET=172.31.10.0/24
DNS_SUBNET=172.31.53.0/28
UNBOUND_IP=172.31.53.2

# ── DHCP (Pi-hole) ──────────────────────────────────────────────────────────
# sieve is the only DHCP server. The compose file switches it on and
# mochaPot's off, so no setting here can end up with two. Keep DHCP off on
# the routers; see pihole/README.md, "Handing over DHCP".
PIHOLE_DHCP_START=192.168.0.50
PIHOLE_DHCP_END=192.168.0.250
# Clients renew at half the lease, so 7d is about 3.5 days of grace if sieve dies.
PIHOLE_DHCP_LEASE=7d

# Extra static leases and names beyond the fleet nodes, semicolon-separated:
#   leases  MAC,IP,name   e.g. aa:bb:cc:dd:ee:ff,192.168.0.20,roastery
#   names   IP name       e.g. 192.168.0.20 roastery
# roastery isn't in NODE_IPS, so its name goes here (and on mochaPot too)
# for ollama.${DOMAIN} to get a record.
PIHOLE_DHCP_EXTRA_HOSTS=
PIHOLE_DNS_EXTRA_HOSTS=

# Written by render-configs.sh from the fleet list, the extras above and
# every Traefik route in the repo. Don't edit these by hand.
PIHOLE_DHCP_HOSTS=
PIHOLE_DNS_HOSTS=
PIHOLE_DNSMASQ_LINES=

# ── Scrutiny collector ──────────────────────────────────────────────────────
# sieve's one disk, a 240 GB 2.5" SATA SSD. Check with `lsblk -d -o NAME,SIZE,MODEL`.
DISK_DEVICE=REPLACE_ME
