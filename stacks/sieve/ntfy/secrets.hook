# shellcheck shell=bash
# Sourced by _lib/secrets.sh after secrets.conf. ntfy wants its users, access
# rules and tokens as three comma-separated lists, so they're rebuilt from the
# pieces on every run. Edit the pieces, never these three.

ntfy_list() {  # ntfy_list <built-in entries> <EXTRA key>
  local extra
  extra="$(env_get "$FILE" "$2")"
  printf '%s%s' "$1" "${extra:+,$extra}"
}

if secret_set ntfy NTFY_ADMIN_HASH && secret_set ntfy NTFY_GATUS_HASH; then
  env_put "$FILE" NTFY_AUTH_USERS "$(ntfy_list \
    "$(env_get "$FILE" NTFY_ADMIN_USER):$(env_get "$FILE" NTFY_ADMIN_HASH):admin,gatus:$(env_get "$FILE" NTFY_GATUS_HASH):user" \
    NTFY_EXTRA_USERS)"
elif ! env_has "$FILE" NTFY_AUTH_USERS; then
  env_put "$FILE" NTFY_AUTH_USERS REPLACE_ME   # the hashing failed; setup says so
fi
env_put "$FILE" NTFY_AUTH_ACCESS "$(ntfy_list "gatus:$(env_get "$FILE" NTFY_ALERT_TOPIC):wo" NTFY_EXTRA_ACCESS)"
env_put "$FILE" NTFY_AUTH_TOKENS "$(ntfy_list "gatus:$(env_get "$FILE" GATUS_NTFY_TOKEN):gatus" NTFY_EXTRA_TOKENS)"
