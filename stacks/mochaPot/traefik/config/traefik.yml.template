# Rendered by ../../render-configs.sh into config/traefik.yml (gitignored).
log:
  level: INFO

entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
  websecure:
    address: ":443"

certificatesResolvers:
  cloudflare:
    acme:
      email: ${TRAEFIK_ACME_EMAIL}
      storage: /acme/acme.json
      dnsChallenge:
        provider: cloudflare
        # DNS-01: the house is behind CGNAT, so HTTP-01 was never an option.
        resolvers:
          - "1.1.1.1:53"
          - "1.0.0.1:53"

providers:
  docker:
    endpoint: "unix:///var/run/docker.sock"
    exposedByDefault: false
    # Not scoped to mochapot_net: the apps are host-networked and never join
    # it. The provider still reads their labels; the address comes from each
    # label's server URL.
  file:
    filename: /etc/traefik/dynamic.yml
