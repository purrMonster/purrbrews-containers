# mochaPot's own settings. ./setup-secrets.sh copies this to .env.local
# (gitignored) and asks for every REPLACE_ME. Nothing here is secret.
#
# Loaded after stacks/fleet.env (LAN, gateway, node IPs, DNS_PRIMARY and
# DNS_SECONDARY) and /opt/purrbrews/.env (NODE, NODE_IP, PUID/PGID, DATA_DIR).

# ── Domain ──────────────────────────────────────────────────────────────────
DOMAIN=REPLACE_ME.example.com
# Let's Encrypt account email, for expiry warnings.
TRAEFIK_ACME_EMAIL=REPLACE_ME@example.com

# ── Network ─────────────────────────────────────────────────────────────────
# mochapot_net's subnet, fixed. Home Assistant has to trust Traefik by
# address, and a container's own IP changes every time it's recreated; the
# subnet doesn't. If the network already exists on another subnet, compose.sh
# warns: stop its containers, `sudo docker network rm mochapot_net`, and let
# compose.sh recreate it.
PROXY_SUBNET=172.30.13.0/24

# ── Kiosk ───────────────────────────────────────────────────────────────────
# What the wall screen shows. Home Assistant's root for now; a specific
# dashboard view once there is one.
KIOSK_URL=http://127.0.0.1:8123

# ── Scrutiny collector ──────────────────────────────────────────────────────
# The 128 GB M.2 SATA drive. Check with `lsblk -d -o NAME,SIZE,MODEL`.
DISK_DEVICE=REPLACE_ME

# ── Pi-hole (secondary) ─────────────────────────────────────────────────────
# Keep PIHOLE_DNS_EXTRA_HOSTS the same as sieve's; roastery goes here
# ("192.168.0.20 roastery") so ollama.${DOMAIN} gets a record.
PIHOLE_DNS_EXTRA_HOSTS=
# Written by render-configs.sh; don't edit by hand.
PIHOLE_DNS_HOSTS=
PIHOLE_DNSMASQ_LINES=
