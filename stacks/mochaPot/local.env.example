# Named local.env.example (not .env.local.example) — same device-bridge
# write-guard workaround as every other node's local.env.example.
#
# Copy this file to .env.local (covered by this repo's `*.env.local`
# .gitignore rule — never commit the real one) and fill in real values.
# Shared by every app in this stack via ./compose.sh and render-configs.sh.
#
# mochaPot's stack directory was rebuilt from scratch 2026-09-16 for the
# post-restructure fleet (see infrastructure.md §2-4 and runbook.md's
# 2026-09-16 entry). Home Assistant moved here from percolator (was
# `postgres-homeassistant` there pre-restructure); this is a role change,
# not a like-for-like migration — nothing here is inherited from the old
# node's own .env.local.

MOCHAPOT_LAN_IP=REPLACE_ME
TZ=Asia/Kolkata
# Used by firewall.sh (added 2026-09-16). Same default as percolator's/
# sieve's own local.env.example.
LAN_CIDR=192.168.0.0/24
# Same real domain as every other node's local.env.example DOMAIN. Not yet
# load-bearing on mochaPot (no Traefik lives here, same as cellar — see
# README "Known gaps"), kept from the start anyway.
DOMAIN=REPLACE_ME.example.com
# infrastructure.md §3: mochaPot's M.2 slot takes SATA (confirmed on the
# x360, unlike the ThinkCentres' NVMe-only slots), currently empty -- no
# disk device var needed here yet since no app on this stack's list
# monitors SMART directly (Scrutiny's collector for mochaPot, if/when
# added, would need one then, not now).

# kiosk/bash_profile.template's target URL -- the actual dashboard view to
# show on the wall screen. Defaults to Home Assistant's own root on this
# same node; replace with a specific lovelace view URL once one exists.
KIOSK_URL=http://127.0.0.1:8123

# ── Traefik ─────────────────────────────────────────────────────────────────
# percolator's LAN IP -- traefik/config/dynamic.yml.template's ForwardAuth
# middleware needs this to reach percolator's Authelia (infrastructure.md
# §4). Confirm it matches percolator's own .env.local exactly, once that
# node exists in this repo.
PERCOLATOR_LAN_IP=REPLACE_ME
TRAEFIK_ACME_EMAIL=REPLACE_ME@REPLACE_ME.example.com

# ── Komodo Periphery / Scrutiny collector ────────────────────────────────────
# Added 2026-09-16 — see komodo-periphery/ and scrutiny-collector/, both new
# standalone agents pointed at cellar's Komodo Core and Scrutiny hub
# (stacks/cellar/komodo/ and stacks/cellar/scrutiny/). README "Known gaps"
# used to say this would wait on a stacks/_templates/komodo-periphery/
# template that never landed — built directly from cellar's own Periphery
# block instead, same as every other node.
CELLAR_LAN_IP=REPLACE_ME
# infrastructure.md §3: mochaPot's M.2 slot takes SATA (128 GB, confirmed
# on the x360 — the only fleet slot besides sieve's that isn't NVMe-only),
# no HDD in this machine (it's the one that gets moved). CONFIRM against
# real hardware with `lsblk -d -o NAME,TYPE,SIZE,MODEL` before trusting
# this.
MOCHAPOT_DISK_DEVICE=REPLACE_ME


