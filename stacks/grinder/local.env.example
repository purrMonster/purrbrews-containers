# Named local.env.example (not .env.local.example) — same device-bridge
# write-guard workaround as every other node's local.env.example.
#
# Copy this file to .env.local (covered by this repo's `*.env.local`
# .gitignore rule) and fill in real values. Shared by every app in this
# stack via ./compose.sh and render-configs.sh.
#
# grinder is entirely NEW to this fleet — it did not exist in the
# pre-restructure purrBrews-infra repo at all (infrastructure.md §1:
# "grinder new"). This is the fleet's landing zone for cheap-to-shed
# automation/AI/self-tracking apps (infrastructure.md §4: "grinder holds
# nothing household-critical... which is what makes its free memory the
# landing zone when another node dies").

GRINDER_LAN_IP=REPLACE_ME
TZ=Asia/Kolkata
DOMAIN=REPLACE_ME.example.com
# roastery's LAN IP -- openwebui/docker-compose.yml's OLLAMA_BASE_URL
# needs this to reach roastery's native Windows Ollama service
# (infrastructure.md §4/§9: a per-user tray app, not a background service
# -- it only answers once someone is logged in on roastery, and roastery
# sleeps rather than shuts down between uses). Not the same value as
# ROASTERY_TAILNET_IP from the pre-restructure fleet's Headscale plan --
# infrastructure.md §4 explicitly drops Headscale ("Cloudflare Tunnel
# cannot carry the Tailscale control protocol on any plan"), so this is
# the plain LAN IP.
ROASTERY_LAN_IP=REPLACE_ME
# esphome/docker-compose.yml's network_mode: host needs to know which
# interface to bind mDNS on if this node ever has more than one -- get it
# with:
#   ip -o link show | awk -F': ' '!/lo|vir|docker/ {print $2}'
GRINDER_LAN_INTERFACE=REPLACE_ME

# ── Traefik ─────────────────────────────────────────────────────────────────
# percolator's LAN IP -- traefik/config/dynamic.yml.template's ForwardAuth
# middleware needs this to reach percolator's Authelia (infrastructure.md
# §4). Confirm it matches percolator's own .env.local exactly, once that
# node exists in this repo.
PERCOLATOR_LAN_IP=REPLACE_ME
TRAEFIK_ACME_EMAIL=REPLACE_ME@REPLACE_ME.example.com

