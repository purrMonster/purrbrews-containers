# Named local.env.example (not .env.local.example) — same device-bridge
# write-guard workaround as every other node's local.env.example (anything
# matching *.env.local* gets blocked, even a harmless placeholder).
#
# Copy this file to .env.local (covered by this repo's `*.env.local`
# .gitignore rule — never commit the real one) and fill in real values.
# Shared by every app in this stack via ./compose.sh and render-configs.sh.
#
# cellar's stack directory was rebuilt from scratch 2026-09-16 for the
# post-restructure fleet (see infrastructure.md §2-3 and runbook.md's
# 2026-09-16 entry) — this is a clean scaffold, not a migration of the old
# cellar/.env.local. Confirm every REPLACE_ME against real hardware before
# running setup-secrets.sh; nothing here is inherited from the pre-restructure
# node.

CELLAR_LAN_IP=REPLACE_ME
TZ=Asia/Kolkata
# Used by firewall.sh (added 2026-09-16 alongside the rest of the fleet's
# nodes) to scope every rule to the LAN. Same default as percolator's/
# sieve's own local.env.example.
LAN_CIDR=192.168.0.0/24
# Same real domain as every other node's local.env.example DOMAIN. Not yet
# load-bearing on cellar (no Traefik lives here — see README "Known gaps"),
# kept from the start anyway so a later app doesn't need a template-file
# change just to gain it.
DOMAIN=REPLACE_ME.example.com

# ── Disks ───────────────────────────────────────────────────────────────────
# infrastructure.md §3 documents cellar as 256 GB M.2 NVMe (OS + restic
# cache) + 1 TB 2.5" HDD (restic repository) — physically separate disks,
# same OS/data-separation discipline as percolator. CONFIRM BOTH against
# real hardware with `lsblk -d -o NAME,TYPE,SIZE,MODEL` before trusting this:
# the pre-restructure cellar had no HDD at all (see the 2026-09-15 private
# notes) — the HDD is new to this rebuild and hasn't been confirmed live.
# NVMe: use the controller node (/dev/nvme0), not the namespace block device
# lsblk shows (/dev/nvme0n1).
CELLAR_DISK_DEVICE_NVME=REPLACE_ME
CELLAR_DISK_DEVICE_HDD=REPLACE_ME
# Where the HDD is mounted — restic's repository and rclone's local cache of
# what's already uploaded both live under here. restic/restic-backup.sh and
# restic/rclone-sync.sh both read this, not a hardcoded path, so a future
# remount elsewhere is a one-line change.
CELLAR_HDD_MOUNT=/srv/backup

# ── Traefik ─────────────────────────────────────────────────────────────────
# percolator's LAN IP -- traefik/config/dynamic.yml.template's ForwardAuth
# middleware needs this to reach percolator's Authelia
# (infrastructure.md §4: Authelia moved to percolator in the post-restructure
# fleet, not sieve). Confirm it matches percolator's own .env.local's
# PERCOLATOR_LAN_IP exactly, once that node exists in this repo.
PERCOLATOR_LAN_IP=REPLACE_ME
# ACME account email for Traefik's Cloudflare DNS-01 cert issuance -- not a
# secret, just needs to be a real address (Let's Encrypt uses it for
# expiry-adjacent notices).
TRAEFIK_ACME_EMAIL=REPLACE_ME@REPLACE_ME.example.com

