# cellar's own settings. ./setup-secrets.sh copies this to .env.local
# (gitignored) and asks for every REPLACE_ME. Nothing here is secret.
#
# Loaded after stacks/fleet.env (LAN, gateway, node IPs) and
# /opt/purrbrews/.env (NODE, NODE_IP, PUID/PGID, DATA_DIR, MEDIA_DIR).

# ── Domain ──────────────────────────────────────────────────────────────────
DOMAIN=REPLACE_ME.example.com
# Let's Encrypt account email, for expiry warnings.
TRAEFIK_ACME_EMAIL=REPLACE_ME@example.com

# ── Disks ───────────────────────────────────────────────────────────────────
# Scrutiny watches both: DISK_DEVICE is the NVMe (OS, the dump store, restic's
# cache), DISK_DEVICE_2 the old 1 TB HDD (no longer holds backups; runbook,
# 2026-09-27). Check with `lsblk -d -o NAME,SIZE,MODEL`; for NVMe use the
# controller, /dev/nvme0.
DISK_DEVICE=REPLACE_ME
DISK_DEVICE_2=REPLACE_ME

# ── Backups ─────────────────────────────────────────────────────────────────
# cellar wakes roastery for the backups (restic/README.md). The MAC of
# roastery's USB NIC (the Realtek dongle, not the onboard I211), e.g.
# aa:bb:cc:dd:ee:ff. `Get-NetAdapter` on roastery shows it.
ROASTERY_WOL_MAC=REPLACE_ME
