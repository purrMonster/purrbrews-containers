# cellar's own settings. ./setup-secrets.sh copies this to .env.local
# (gitignored) and asks for every REPLACE_ME. Nothing here is secret.
#
# Loaded after stacks/fleet.env (LAN, gateway, node IPs) and
# /opt/purrbrews/.env (NODE, NODE_IP, PUID/PGID, DATA_DIR, MEDIA_DIR).

# ── Domain ──────────────────────────────────────────────────────────────────
DOMAIN=REPLACE_ME.example.com
# Let's Encrypt account email, for expiry warnings.
TRAEFIK_ACME_EMAIL=REPLACE_ME@example.com

# ── Disks ───────────────────────────────────────────────────────────────────
# Scrutiny watches both: DISK_DEVICE is the NVMe (OS, restic's cache),
# DISK_DEVICE_2 the 1 TB HDD (the restic repository). Check with
# `lsblk -d -o NAME,SIZE,MODEL`; for NVMe use the controller, /dev/nvme0.
DISK_DEVICE=REPLACE_ME
DISK_DEVICE_2=REPLACE_ME
# Where the HDD is mounted. The restic scripts read this rather than a path.
CELLAR_HDD_MOUNT=/srv/backup

# ── restic, later ───────────────────────────────────────────────────────────
# Not needed until the roastery mirror and failure alerts are switched on
# (restic/README.md). Left out of this file on purpose until then:
#   NTFY_URL              ntfy topic URL for failure alerts
#   ROASTERY_WOL_MAC      roastery's USB NIC, for the mirror's wake-on-LAN
#   ROASTERY_SSH_HOST     user@host for the mirror
#   ROASTERY_MIRROR_PATH  where on roastery the mirror goes
