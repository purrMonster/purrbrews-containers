# Rendered by ../../render-configs.sh into config/dynamic.yml (gitignored).
http:
  middlewares:
    authelia-forwardauth:
      forwardAuth:
        # percolator's Authelia (infrastructure.md §4). cellar must be
        # added to percolator's FORWARD_AUTH_CLIENTS/firewall.sh and to
        # Authelia's admin_hosts list for this to actually work -- see
        # README "Known gaps" if komodo.${DOMAIN}/scrutiny.${DOMAIN}
        # 502/504. Every router below still works on its direct host port
        # with no middleware in the path (the backdoor).
        address: "http://${PERCOLATOR_LAN_IP}:9091/api/authz/forward-auth"
        trustForwardHeader: true
        authResponseHeaders:
          - Remote-User
          - Remote-Groups
          - Remote-Name
          - Remote-Email
