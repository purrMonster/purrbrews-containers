# Rendered by ../../render-configs.sh into config/dynamic.yml (gitignored).
#
# The ForwardAuth middleware the app labels use as authelia-forwardauth@file.
# It calls Authelia directly on percolator:9091: going through percolator's
# Traefik drops X-Forwarded-Method and Authelia answers 400. For this to
# work, cellar's IP has to be in percolator's FORWARD_AUTH_CLIENTS, and
# komodo/scrutiny in Authelia's admin host list (both done).
http:
  middlewares:
    authelia-forwardauth:
      forwardAuth:
        address: "http://${PERCOLATOR_LAN_IP}:9091/api/authz/forward-auth"
        trustForwardHeader: true
        authResponseHeaders:
          - Remote-User
          - Remote-Groups
          - Remote-Name
          - Remote-Email
