# Rendered by ../render-configs.sh into rclone.conf (gitignored -- see
# ../.gitignore). Two remotes: `drive` is the raw Google Drive OAuth
# remote (its own API client, not rclone's shared default -- see
# generate-secrets.sh's comment on RCLONE_DRIVE_CLIENT_ID/_SECRET), `drive-crypt`
# wraps it so file names and structure are encrypted before they ever
# reach Google, not just the restic pack contents underneath.
#
# After the first render, run once, by hand (needs a browser):
#   rclone config reconnect drive: --config rclone.conf
# and set a real crypt password/salt with:
#   rclone config password drive-crypt password  --config rclone.conf
#   rclone config password drive-crypt password2 --config rclone.conf
# (rclone prompts for the value interactively -- do not put a plaintext
# crypt password in this template; it isn't a secrets.env.local key
# because it never needs substituting into anything else.)

[drive]
type = drive
client_id = ${RCLONE_DRIVE_CLIENT_ID}
client_secret = ${RCLONE_DRIVE_CLIENT_SECRET}
scope = drive

[drive-crypt]
type = crypt
remote = drive:purrbrews-cellar-restic
filename_encryption = standard
directory_name_encryption = true
