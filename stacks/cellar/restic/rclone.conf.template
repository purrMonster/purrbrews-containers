# Rendered by ../render-configs.sh into rclone.conf (gitignored).
#
# `drive` is the Google Drive remote on my own API client; `drive-crypt`
# wraps it so names and folder structure are encrypted before Google sees
# them. The OAuth token and the crypt passwords are added by rclone itself
# after the first render (restic/README.md, steps 3 and 4); they never go in
# this template.

[drive]
type = drive
client_id = ${RCLONE_DRIVE_CLIENT_ID}
client_secret = ${RCLONE_DRIVE_CLIENT_SECRET}
scope = drive

[drive-crypt]
type = crypt
remote = drive:purrbrews-cellar-restic
filename_encryption = standard
directory_name_encryption = true
