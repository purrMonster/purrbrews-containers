// purrBrews tailnet policy. The admin console holds the live copy
// (Access controls → JSON editor); this file is what it should say. Change
// it here first, commit, then paste. Pasting replaces the whole policy,
// including Tailscale's default allow-everything rule, which is the point.
//
// Why each line is here: tailscale/README.md. No email addresses in this
// file, since the repo is public; autogroups stand in for people.
{
	"tagOwners": {
		// The five Debian nodes join with this tag (init's tailscale step).
		// Tagged devices belong to the tailnet, not to a person, and their
		// keys don't expire, so a server never silently drops off.
		"tag:purrbrews-node": ["autogroup:admin"],
	},

	// The subnet routers (TAILSCALE_SUBNET_ROUTERS: cellar, grinder) advertise
	// the house's addresses as a /23. Approved automatically when a tagged
	// node asks, so re-running init never waits on a click in the console.
	"autoApprovers": {
		"routes": {
			"192.168.0.0/23": ["tag:purrbrews-node"],
		},
	},

	"grants": [
		// SSH to the nodes, for the tailnet's admins only (you). UFW on each
		// node allows 22 on tailscale0 and nothing else, so this is the only
		// port that would answer anyway; both layers agree.
		{
			"src": ["autogroup:admin"],
			"dst": ["tag:purrbrews-node"],
			"ip":  ["tcp:22"],
		},
		// Remote Desktop between your own devices: laptop or phone → roastery.
		// autogroup:self never includes someone else's devices, so inviting
		// another person later gives them nothing of yours.
		{
			"src": ["autogroup:member"],
			"dst": ["autogroup:self"],
			"ip":  ["tcp:3389", "udp:3389"],
		},
		// Every app, admin pages included, at its usual LAN address through a
		// subnet router: each node's Traefik (and roastery's, for Ollama) on 443.
		// Only these six addresses, only 443, though the route is a /23. Who
		// may open what is still Authelia's call, exactly as on the LAN.
		{
			"src": ["autogroup:member"],
			"dst": ["192.168.0.10/32", "192.168.0.11/32", "192.168.0.12/32",
			        "192.168.0.13/32", "192.168.0.14/32", "192.168.0.15/32"],
			"ip":  ["tcp:443"],
		},
		// The two Pi-holes, for split DNS: the app names resolve the same way
		// away from home as at home.
		{
			"src": ["autogroup:member"],
			"dst": ["192.168.0.10/32", "192.168.0.13/32"],
			"ip":  ["udp:53", "tcp:53"],
		},
	],

	// Deliberately absent:
	//  - no rule *from* tag:purrbrews-node: a node can't open anything on the
	//    tailnet, so a compromised node can't reach your laptop through it;
	//  - no "ssh" section: the nodes run OpenSSH with their own keys and
	//    sudo, not Tailscale SSH;
	//  - no exit node, and nothing on the LAN beyond the six hosts above,
	//    port 443, and DNS on the two Pi-holes.
}
