# purrbrews-init.env — settings for purrbrews-init.sh
#
# Nothing in this file is secret. It is served openly by purrbrews-bootstrap on
# roastery (copy it to bootstrap/data/purrbrews-init.env), or can sit next to
# purrbrews-init.sh for the USB route.
#
# Format: KEY=value, one per line. Nothing is executed or expanded: $, spaces
# and backslashes are literal. One pair of surrounding quotes is stripped.
# Windows (CRLF) line endings and a UTF-8 BOM are fine.

# ── Repository ──────────────────────────────────────────────────────────────
# GitHub is the public mirror: nodes clone and pull anonymously over https.
# No tokens, no deploy keys — never put a credential in this URL.
REPO_URL=https://github.com/purrMonster/purrbrews-containers.git
REPO_BRANCH=main

# ── Nodes ───────────────────────────────────────────────────────────────────
# Space-separated name=ip. Pass the name to the script (case-insensitive), or
# install Debian with it as the hostname. Every node gets all of them in
# /etc/hosts. Keep .1–.5 free (routers/switches).
NODE_IPS=sieve=192.168.0.10 percolator=192.168.0.11 cellar=192.168.0.12 mochaPot=192.168.0.13 grinder=192.168.0.14

# ── Cloned MAC addresses ────────────────────────────────────────────────────
# Each node's wired interface gets a fixed MAC instead of the NIC's own, so the
# router / Pi-hole always see the same device, even after a NIC swap or a new
# USB dongle. By default it's derived from the node name (02:…, locally
# administered). See them all with:  bash purrbrews-mac.sh list
CLONE_MAC=true
# Optional overrides, space-separated name=mac (e.g. to keep a MAC the router
# already has a reservation for):
NODE_MACS=

# ── SSH keys (no copy-pasting per device) ───────────────────────────────────
# Normally nothing to set here: bootstrap.sh points every node at
# purrbrews-bootstrap on roastery (bootstrap/data/authorized_keys), pinned to
# its TLS key, and an hourly timer keeps each node in sync with that file.
# Add a key there → every node has it within the hour; delete it → it's gone.
#
# Extra https sources in authorized_keys format (space-separated), optional.
SSH_KEYS_URLS=
# Optional: GitHub usernames whose github.com/<user>.keys are also trusted.
SSH_KEYS_GITHUB_USERS=
# Optional allowlist of SHA256 fingerprints (space-separated). When set, only
# these keys are ever installed, whatever the sources serve.
# Get them with: ssh-keygen -lf ~/.ssh/id_ed25519.pub
SSH_KEY_FINGERPRINTS=
# (A file named authorized_keys next to purrbrews-init.sh is also picked up —
#  for the USB/scp route without roastery.)

# ── Ops account ─────────────────────────────────────────────────────────────
OPS_USER=barista
# barista's sudo password is typed at each node's console during setup
# (or generated into /root/purrbrews-ops-password with --yes).
# OPS_PASSWORD_HASH (from 'openssl passwd -6') only for the USB route with a
# local, root-only copy of this file. roastery refuses to serve a file that has it.
OPS_PASSWORD_HASH=
# Who may log in over SSH (space-separated). Defaults to OPS_USER.
SSH_ALLOW_USERS=

# ── Network ─────────────────────────────────────────────────────────────────
CONFIGURE_STATIC_IP=true
GATEWAY=192.168.0.1
SUBNET_CIDR=24
LAN_CIDR=192.168.0.0/24
# Used until Pi-hole is up; change later per node if you like.
BOOTSTRAP_DNS=1.1.1.1 9.9.9.9

# ── System ──────────────────────────────────────────────────────────────────
TZ=Asia/Kolkata
PROJECT_DIR=/opt/purrbrews
DATA_DIR=/srv/data
MEDIA_DIR=/srv/media
JOURNAL_MAX_USE=500M
DISABLE_SLEEP=true

# ── Firewall ────────────────────────────────────────────────────────────────
ENABLE_UFW=true
# ufw-docker is pinned to a release tag and verified by checksum.
UFW_DOCKER_VERSION=251123
UFW_DOCKER_SHA256=c3e5f0bf6061a3a2e7d7ac06abc80665707d2f4c91e90d76f22e4168863fb472

# ── Timers ──────────────────────────────────────────────────────────────────
# systemd OnCalendar syntax. Missed runs (node was off) run at next boot.
PULL_SCHEDULE=*-*-* 06:15:00
KEY_SYNC_SCHEDULE=hourly
# Optional healthchecks.io ping URL for the daily pull (alerts on silence).
PULL_HEALTHCHECK_URL=
