# mochaPot's own settings. ./setup-secrets.sh copies this to .env.local
# (gitignored) and asks for every REPLACE_ME. Nothing here is secret.
#
# Loaded after stacks/fleet.env (LAN, gateway, node IPs, DNS_PRIMARY and
# DNS_SECONDARY) and /opt/purrbrews/.env (NODE, NODE_IP, PUID/PGID, DATA_DIR).

# ── Domain ──────────────────────────────────────────────────────────────────
DOMAIN=REPLACE_ME.example.com
# Let's Encrypt account email, for expiry warnings.
TRAEFIK_ACME_EMAIL=REPLACE_ME@example.com

# ── Network ─────────────────────────────────────────────────────────────────
# proxy's subnet, fixed so firewall.sh works before any container has run. If the network already exists on another subnet, compose.sh
# warns: stop its containers, `sudo docker network rm proxy`, and let
# compose.sh recreate it.
PROXY_SUBNET=172.30.13.0/24

# ── Kiosk ───────────────────────────────────────────────────────────────────
# What the wall screen shows. Home Assistant (on cellar) straight to its port,
# not through Traefik, so the screen doesn't depend on DNS or certificates;
# a specific dashboard view once there is one.
KIOSK_URL=http://192.168.1.12:8123

# ── Scrutiny collector ──────────────────────────────────────────────────────
# The 128 GB M.2 SATA drive. Check with `lsblk -d -o NAME,SIZE,MODEL`.
DISK_DEVICE=REPLACE_ME
# This SanDisk's statistics log is stuck, so its collector reads it another
# way (the file says why). Drop this line if the drive is ever replaced.
SCRUTINY_COLLECTOR_CONFIG=/opt/purrbrews/nodes/mochaPot/scrutiny-collector.yaml

# ── Pi-hole (secondary) ─────────────────────────────────────────────────────
# Keep PIHOLE_DNS_EXTRA_HOSTS the same as sieve's.
PIHOLE_DNS_EXTRA_HOSTS=
# Written by render-configs.sh; don't edit by hand.
PIHOLE_DNS_HOSTS=
PIHOLE_DNSMASQ_LINES=
