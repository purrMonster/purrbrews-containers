# cellar's own settings. ./setup-secrets.sh copies this to .env.local
# (gitignored) and asks for every REPLACE_ME. Nothing here is secret.
#
# Loaded after stacks/fleet.env (LAN, gateway, node IPs) and
# /opt/purrbrews/.env (NODE, NODE_IP, PUID/PGID, DATA_DIR, MEDIA_DIR).

# ── Domain ──────────────────────────────────────────────────────────────────
DOMAIN=REPLACE_ME.example.com
# Let's Encrypt account email, for expiry warnings.
TRAEFIK_ACME_EMAIL=REPLACE_ME@example.com

# ── Network ─────────────────────────────────────────────────────────────────
# The proxy network's subnet, fixed so firewall.sh works before any container
# has run. Only change it before the first bring-up.
PROXY_SUBNET=172.30.12.0/24

# ── Disks ───────────────────────────────────────────────────────────────────
# Scrutiny watches DISK_DEVICE: the NVMe that holds the OS, the dump store and,
# since the 2026-11 rebuild, the restic repository (docs/hardware.md). Check
# with `lsblk -d -o NAME,SIZE,MODEL`; for NVMe use the controller, /dev/nvme0.
# DISK_DEVICE_2 is for a second internal disk; leave it out if there is none.
DISK_DEVICE=REPLACE_ME

# ── Voice (docs/voice.md) ───────────────────────────────────────────────────
# The name this room's satellite has in Home Assistant (default: the node's).
# VOICE_ROOM=third room
# The mic and speaker, if PipeWire's defaults aren't them (names from
# sudo stacks/voice/voice-satellite/host-setup.sh --list).
# VOICE_INPUT_DEVICE=
# VOICE_OUTPUT_DEVICE=
